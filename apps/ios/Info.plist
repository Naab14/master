<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Master backend is a plain-HTTP server on your own network
	     (same trust model as Frieday). Allow local-network HTTP only. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Master connects to your self-hosted Master backend on the local network to sync shifts, vacations, and boards.</string>
</dict>
</plist>
